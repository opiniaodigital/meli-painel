<!doctype html>
<html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Pedidos - Painel Mercado Livre</title><link rel="stylesheet" href="/style.css"></head>
<body><header><a class="brand" href="/painel"><span class="mark" aria-hidden="true">M</span> Painel Mercado Livre</a><span class="status">Conta conectada</span></header><main>
<div class="page-heading"><div><span class="eyebrow">OPERACAO DA LOJA</span><h1>Pedidos</h1><p>Pedidos dos ultimos 60 dias - sincronizacao automatica a cada hora</p></div><form method="post" action="/pedidos/atualizar"><button class="button" type="submit">Atualizar</button></form></div>
<form class="filters" method="get" action="/pedidos"><label>De <input type="date" name="de" value="<%= filtros.de %>"></label><label>Ate <input type="date" name="ate" value="<%= filtros.ate %>"></label><label>Status <select name="status"><option value="">Todos</option><% statuses.forEach(value => { %><option value="<%= value %>" <%= filtros.status === value ? 'selected' : '' %>><%= value %></option><% }) %></select></label><button class="button secondary" type="submit">Filtrar</button></form>
<p class="small">Ultima sincronizacao: <%= ultimaSincronizacao ? date(ultimaSincronizacao) : 'ainda nao realizada' %></p>
<section class="ranking"><div class="table-scroll"><table><thead><tr><th>Data</th><th>Numero</th><th>Comprador</th><th>Itens</th><th class="numeric">Total</th><th>Status</th><th>Envio</th><th>Tipo</th></tr></thead><tbody>
<% if (!pedidos.length) { %><tr><td colspan="8"><div class="empty"><h3>Nenhum pedido encontrado</h3><p>Ajuste os filtros ou atualize os dados.</p></div></td></tr><% } %>
<% pedidos.forEach(pedido => { %><tr><td><%= date(pedido.date_created) %></td><td><strong><%= pedido.order_id %></strong></td><td><%= pedido.buyer_nickname || '-' %></td><td><% pedido.items.forEach(item => { %><div><strong><%= item.sku || 'Sem SKU' %></strong> - <%= item.title || 'Sem titulo' %> - <%= item.quantity %> x <%= money(item.unit_price) %></div><% }) %></td><td class="numeric"><%= money(pedido.total_amount) %></td><td><span class="badge"><%= pedido.order_status %></span></td><td><%= pedido.shipping_status || '-' %></td><td><%= pedido.shipping_type || '-' %></td></tr><% }) %>
</tbody></table></div></section></main><footer><a href="/painel">Voltar ao painel</a> - Dados consultados na sua conta</footer></body></html>
