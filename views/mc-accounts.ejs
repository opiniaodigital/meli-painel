<section class="table-panel"><div class="section-head"><h2>Resumo por conta</h2></div><div class="table-scroll"><table><thead><tr><th>Conta</th><th>Pedidos</th><th>Faturamento</th><th>MC</th><th>Pendências de MC</th></tr></thead><tbody><% d.byAccount.forEach(a => { %><tr><td><%= a.name %></td><td><%= a.count %></td><td><%= cmoney(a.revenue) %></td><td><%= cmoney(a.mc) %></td><td><%= a.incomplete %></td></tr><% }) %></tbody></table></div></section>
