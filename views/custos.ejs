<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Custos - Painel Mercado Livre</title><link rel="stylesheet" href="/style.css"></head><body><header><a class="brand" href="/painel"><span class="mark">M</span> Painel Mercado Livre</a></header><main><div class="page-heading"><div><span class="eyebrow">CONFIGURACAO</span><h1>Custos por SKU</h1><p>Cadastre custo unitario e imposto para calcular a margem.</p></div></div><% if (erro) { %><aside class="notice"><%= erro %></aside><% } %><section class="ranking"><h2>Colar CSV</h2><p>Formato: <code>sku;custo;imposto%</code>, uma linha por SKU.</p><form method="post" action="/custos"><textarea name="csv" rows="6" placeholder="SKU-001;25,90;12,5"></textarea><button class="button" type="submit">Importar CSV</button></form></section><section class="ranking"><h2>Adicionar linha</h2><form class="filters" method="post" action="/custos"><label>SKU <input name="sku" required></label><label>Custo <input name="custo" type="number" step="0.01" min="0" required></label><label>Imposto % <input name="imposto" type="number" step="0.01" min="0" value="0" required></label><button class="button secondary" type="submit">Salvar</button></form></section><section class="ranking"><h2>Custos cadastrados</h2><div class="table-scroll"><table><thead><tr><th>SKU</th><th>Custo unitario</th><th>Imposto %</th><th></th></tr></thead><tbody><% custos.forEach(custo => { %><tr><td><%= custo.sku %></td><td><%= money(custo.custo_unitario) %></td><td><%= custo.imposto_percentual %>%</td><td><form method="post" action="/custos"><input type="hidden" name="excluir" value="<%= custo.sku %>"><button class="button secondary" type="submit">Excluir</button></form></td></tr><% }) %><% if (!custos.length) { %><tr><td colspan="4">Nenhum custo cadastrado.</td></tr><% } %></tbody></table></div></section></main><footer><a href="/margem">Ir para margem</a></footer></body></html>
